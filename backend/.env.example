NODE_ENV=development
PORT=4000
API_PREFIX=v1
APP_NAME=Maddy Backend
APP_VERSION=0.1.0
GIT_SHA=local

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/maddy_backend?schema=public

# Allowed: dev|clerk
# SECURITY: AUTH_MODE=dev is blocked when NODE_ENV=production.
AUTH_MODE=dev
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_ISSUER=

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=maddy-assets
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_UPLOAD_URL_TTL_SECONDS=900

PG_BOSS_SCHEMA=pgboss
PG_BOSS_ENABLED=true

OTEL_SERVICE_NAME=maddy-backend
OTEL_ENABLED=true
